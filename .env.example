# Mapbox public access token. Required for the /atlas page.
# Get one at: https://account.mapbox.com/access-tokens
# Set this in Vercel as an environment variable.
NEXT_PUBLIC_MAPBOX_TOKEN=

# The deployed site URL (used for canonical links / OG tags).
# Vercel sets this automatically; override locally if needed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Mapbox style URL. Defaults to a Bedrock-styled basemap if unset.
# Customize via Mapbox Studio for the cleanest research aesthetic.
NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/light-v11
